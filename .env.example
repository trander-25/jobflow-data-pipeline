# Discord
DISCORD_TOKEN="your_discord_token"
DISCORD_CHANNEL_ID="your_discord_channel_id"

# PostgreSQL & Airflow
POSTGRES_HOST_PORT="5432"
DB_USER="user"
DB_PASSWORD="password"
DB_HOST="postgresql_db"
DB_PORT="5432"
DB_JOB="job_db"
DB_AIRFLOW="airflow_db"
DB_TRINO="catalog_wh"
EMAIL="no_need"
EMAIL_PASSWORD="no_need"
AIRFLOW_WEBSERVER_PORT="8080"
AIRFLOW_WEBSERVER_SECRET_KEY="random_secret_key"

# MinIO
MINIO_VERSION="RELEASE.2025-09-07T16-13-09Z-cpuv1"
MINIO_MC_VERSION="RELEASE.2025-08-13T08-35-41Z-cpuv1"
MINIO_USER="user"
MINIO_PASSWORD="password"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MINIO_WAREHOUSE_BUCKET="warehouse"
MINIO_CRAWLED_DATA_BUCKET="crawled-data"

# Trino
TRINO_VERSION="481"
TRINO_HOST_PORT="8081"
TRINO_CONN_ID="trino_default"

# MongoDB
MONGODB_VERSION="8.0"
MONGODB_USERNAME="user"
MONGODB_PASSWORD="password"
MONGODB_DB="jobflow"
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_HOST_PORT="27017"

# Redis
REDIS_VERSION="7.4.9-alpine"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_HOST_PORT="6379"

# Chroma
CHROMA_VERSION="1.5.2"
CHROMA_HOST="chroma"
CHROMA_HOST_PORT="8000"
CHROMA_PORT="8000"
CHROMA_LISTEN_ADDRESS="0.0.0.0"
CHROMA_PERSIST_PATH="/data"
CHROMA_ALLOW_RESET="false"
CHROMA_COLLECTION_NAME="job_embeddings"
CHROMA_BATCH_SIZE="20"

# Docker volumes
POSTGRES_VOLUME_NAME="jobflow_postgres_data"
MINIO_VOLUME_NAME="jobflow_minio_data"
CHROMA_VOLUME_NAME="jobflow_chroma_data"
MONGODB_VOLUME_NAME="jobflow_mongodb_data"
